var _language: String = SPANISH

func _ready() -> void:
	var translation: Translation = Translation.new()
	translation.locale = ENGLISH
	for key: String in EN:
		translation.add_message(key, String(EN[key]))
	TranslationServer.add_translation(translation)
	var config: ConfigFile = ConfigFile.new()
	if config.load(SETTINGS_PATH) == OK:
		_language = String(config.get_value("general", "language", SPANISH))
	if _language != ENGLISH:
		_language = SPANISH
	# Las pruebas automáticas (sin pantalla) siempre van en español, el idioma
	# en el que están escritas sus comprobaciones.
	if DisplayServer.get_name() == "headless":
		_language = SPANISH
	TranslationServer.set_locale(_language)

## Idioma activo: "es" o "en".
func get_language() -> String:
	return _language

## ¿El juego está en inglés?
func is_english() -> bool:
	return _language == ENGLISH

## Cambia el idioma, lo guarda y avisa a quien escuche `language_changed`.
func set_language(code: String) -> void:
	var new_language: String = ENGLISH if code == ENGLISH else SPANISH
	if new_language == _language:
		return
	_language = new_language
	TranslationServer.set_locale(_language)
	var config: ConfigFile = ConfigFile.new()
	config.load(SETTINGS_PATH)
	config.set_value("general", "language", _language)
	config.save(SETTINGS_PATH)
	language_changed.emit(_language)

## Alterna entre español e inglés.
func toggle_language() -> void:
	set_language(SPANISH if is_english() else ENGLISH)
