[gd_scene format=3]

; HUD de la misión, versión "para niños" (7-12 años).
;
; Reglas de diseño:
;  * Números y nombres grandes: nada de texto de 12 px.
;  * Una tarjeta por zona (sistemas a la izquierda, misión a la derecha) con
;    esquinas muy redondeadas y fondo oscuro translúcido, para que el texto se
;    lea sobre cualquier escena.
;  * Un color por recurso (oxígeno azul, energía amarilla, escudo violeta,
;    agua verde azulada, comida verde) repetido en el nombre y el indicador.
;  * Arriba a la izquierda solo OXÍGENO, ENERGÍA y ESCUDO, como filas de
;    burbujas que se van gastando (`scripts/resource_bubbles.gd`).
;  * Abajo a la izquierda: AGUA y COMIDA solo con nombre y porcentaje, y el
;    minimapa circular con la posición real del jugador
;    (`scripts/hud_minimap.gd`, imagen `ai_assets/IMG/Map/minimapa_habitat.png`).
;  * Todo el HUD se dibuja al 97 % (`MissionHud.UI_SCALE`).
;  * Avisos en una "píldora" centrada y un panel de resultado con una tarjeta
;    grande.
;
; El script `scripts/mission_hud.gd` necesita los nodos con nombre único (%):
; %OxygenBar %OxygenValue %EnergyBar %EnergyValue %ShieldBar %ShieldValue
; %WaterValue %FoodValue %TimerLabel %ScoreLabel %StateLabel %AlertLabel
; %ResultPanel %ResultTitle %ResultDetail %Minimap %ShortCircuitBanner %ShortCircuitLabel.

[ext_resource type="Script" path="res://scripts/mission_hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/resource_bubbles.gd" id="2_bubbles"]
[ext_resource type="Script" path="res://scripts/hud_minimap.gd" id="3_minimap"]
[ext_resource type="Texture2D" uid="uid://bgk88mse081r" path="res://ai_assets/IMG/Map/minimapa_habitat.png" id="4_map"]

