[gd_scene load_steps=24 format=3]

; Simulación de despegue del Apolo 8 (Saturno V), con datos reales en res://resources/apolo8/ascenso.json.
; Capas: %Sky (shader del cielo, se ve por las ventanas transparentes) → %Cockpit (cabina, 4 vistas) → interfaz en %Screen.
; El jugador da las órdenes: despegue, separar 1.ª etapa, soltar torre de escape, separar 2.ª etapa y apagar la S-IVB.

[ext_resource type="Script" path="res://scripts/launch_simulation.gd" id="1_r"]
[ext_resource type="Shader" path="res://resources/shaders/cielo_despegue.gdshader" id="2_r"]
[ext_resource type="Texture2D" path="res://ai_assets/apolo8/cabina_000_frente.png" id="3_r"]
[ext_resource type="Texture2D" path="res://ai_assets/apolo8/etapas/torre_escape.png" id="4_r"]
