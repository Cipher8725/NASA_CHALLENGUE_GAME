theme_override_colors/font_color = Color(0.96, 0.99, 1, 1)
theme_override_font_sizes/font_size = 16
text = "Las 16 piezas del rover están separadas en la mesa. Arrástralas con el ratón hasta su lugar siguiendo el procedimiento, de abajo hacia arriba. Haz clic en una pieza para ver para qué sirve."
horizontal_alignment = 1
autowrap_mode = 3

