[gd_scene load_steps=9 format=3]

; Taller del Rover: entrenamiento para armar el rover Perseverance de la NASA.
;
; Las 16 piezas del modelo 3D oficial de la NASA empiezan separadas sobre la
; mesa y el jugador las arrastra a su lugar (modo guiado o evaluación).
; El modelo y todos los textos vienen de `resources/rover_perseverance.tres`.
; Este archivo solo define el escenario, la cámara y la interfaz.
; El script necesita estos nombres únicos (%):
; %ModelRoot %CameraPivot %Camera %RoverTitle %RoverSubtitle %PhaseLabel
; %ProgressLabel %HintLabel %StepsBox %StepTemplate %InfoCard %PieceIcon
; %PieceName %PieceNameEn %PieceText %PieceMaterial %PieceWhy %PieceFact %PieceLink %ModePanel
; %ResultPanel %ResultTitle %ResultDetail %CreditLabel

[ext_resource type="Script" path="res://scripts/rover_workshop.gd" id="1_workshop"]
[ext_resource type="Resource" path="res://resources/rover_perseverance.tres" id="2_rover"]

[sub_resource type="Environment" id="Environment_workshop"]
background_mode = 1
background_color = Color(0.09, 0.07, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.62, 0.6, 0.66, 1)
ambient_light_energy = 0.35
tonemap_mode = 3
tonemap_exposure = 0.85

[sub_resource type="PlaneMesh" id="PlaneMesh_floor"]
size = Vector2(30, 30)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_floor"]
albedo_color = Color(0.42, 0.24, 0.16, 1)
roughness = 1.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
content_margin_left = 18.0
content_margin_top = 14.0
content_margin_right = 18.0
content_margin_bottom = 14.0
bg_color = Color(0.05, 0.08, 0.15, 0.9)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.45, 0.72, 1, 0.55)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 10.0
bg_color = Color(0.12, 0.2, 0.34, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.72, 1, 0.7)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_result"]
content_margin_left = 34.0
content_margin_top = 26.0
content_margin_right = 34.0
content_margin_bottom = 26.0
bg_color = Color(0.06, 0.16, 0.1, 0.95)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.98, 0.82, 0.3, 1)
corner_radius_top_left = 26
corner_radius_top_right = 26
corner_radius_bottom_right = 26
corner_radius_bottom_left = 26

[node name="RoverWorkshop" type="Node3D"]
script = ExtResource("1_workshop")
rover_data = ExtResource("2_rover")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_workshop")

[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 6, 0)
light_energy = 0.85
shadow_enabled = true

[node name="FillLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.866025, 0.25, -0.433013, 0, 0.866025, 0.5, 0.5, 0.433013, -0.75, 0, 4, 0)
light_energy = 0.3

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_floor")
surface_material_override/0 = SubResource("StandardMaterial3D_floor")

[node name="ModelRoot" type="Node3D" parent="."]
unique_name_in_owner = true

[node name="CameraPivot" type="Node3D" parent="."]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 0)

[node name="Camera" type="Camera3D" parent="CameraPivot"]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 0.8473, 0.5312, 0, -0.5312, 0.8473, 0, 6.6, 10.2)
fov = 55.0

[node name="UILayer" type="CanvasLayer" parent="."]

