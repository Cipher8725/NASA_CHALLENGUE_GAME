[gd_scene load_steps=6 format=3]

; Pantalla "MI CARNET": crear y guardar el carnet del astronauta.

[ext_resource type="Script" path="res://scripts/card_editor.gd" id="1_editor"]
[ext_resource type="PackedScene" path="res://scenes/ui/astronaut_card_view.tscn" id="2_view"]
[ext_resource type="PackedScene" path="res://scenes/ui/photo_booth.tscn" id="3_booth"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 22.0
content_margin_top = 18.0
content_margin_right = 22.0
content_margin_bottom = 18.0
bg_color = Color(0.05, 0.08, 0.15, 0.92)
