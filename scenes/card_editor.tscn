corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[node name="CardEditor" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_editor")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.04, 0.05, 0.1, 1)

[node name="Title" type="Label" parent="."]
layout_mode = 0
offset_left = 40.0
offset_top = 24.0
offset_right = 1240.0
offset_bottom = 74.0
theme_override_colors/font_color = Color(1, 0.86, 0.45, 1)
theme_override_font_sizes/font_size = 36
text = "MI CARNET DE ASTRONAUTA"

[node name="FormPanel" type="PanelContainer" parent="."]
layout_mode = 0
offset_left = 40.0
offset_top = 96.0
offset_right = 540.0
offset_bottom = 690.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Form" type="VBoxContainer" parent="FormPanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="NameTitle" type="Label" parent="FormPanel/Form"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.78, 1, 1)
theme_override_font_sizes/font_size = 18
text = "1. Escribe tu nombre"

[node name="NameEdit" type="LineEdit" parent="FormPanel/Form"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 22
placeholder_text = "Tu nombre de astronauta"

[node name="AvatarTitle" type="Label" parent="FormPanel/Form"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.78, 1, 1)
theme_override_font_sizes/font_size = 18
text = "2. Tómate una foto o elige un dibujo"

[node name="AvatarGrid" type="GridContainer" parent="FormPanel/Form"]
layout_mode = 2
columns = 1

[node name="AvatarRow" type="HBoxContainer" parent="FormPanel/Form/AvatarGrid"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="AvatarTemplate" type="Button" parent="FormPanel/Form/AvatarGrid/AvatarRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(66, 66)
layout_mode = 2
expand_icon = true

[node name="PhotoRow" type="HBoxContainer" parent="FormPanel/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PhotoButton" type="Button" parent="FormPanel/Form/PhotoRow"]
