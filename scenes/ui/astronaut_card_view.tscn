colors = PackedColorArray(0.55, 0.85, 1, 0.9, 0.85, 0.6, 1, 0.9, 0.6, 1, 0.75, 0.9, 1, 0.9, 0.55, 0.9, 0.55, 0.85, 1, 0.9)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_holo"]
gradient = SubResource("Gradient_holo")
width = 128
height = 16
fill_to = Vector2(1, 1)

[node name="AstronautCardView" type="PanelContainer"]
custom_minimum_size = Vector2(640, 404)
offset_right = 640.0
offset_bottom = 404.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_view")

