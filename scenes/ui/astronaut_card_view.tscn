[gd_scene load_steps=10 format=3]

; Carnet del astronauta (vista). Llamar a `show_card(card)` para llenarlo.
; Es un carnet DE JUEGO: no imita ningún documento oficial real.

[ext_resource type="Script" path="res://scripts/astronaut_card_view.gd" id="1_view"]
[ext_resource type="Script" path="res://scripts/card_barcode.gd" id="2_barcode"]
[ext_resource type="Texture2D" path="res://ai_assets/textures/avatares/avatar_1.png" id="3_avatar"]

