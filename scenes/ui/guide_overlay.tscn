theme_override_styles/hover = SubResource("Style_btn_hover")
theme_override_styles/pressed = SubResource("Style_btn_hover")
theme_override_styles/focus = SubResource("Style_btn_hover")
theme_override_styles/disabled = SubResource("Style_btn")
