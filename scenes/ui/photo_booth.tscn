[gd_scene load_steps=8 format=3]

; Cabina de fotos del carnet: cámara en vivo, cuenta 3-2-1, casco opcional y opción de subir foto.
; La foto solo se guarda en la computadora del jugador (user://). No se envía a internet.

[ext_resource type="Script" path="res://scripts/photo_booth.gd" id="1_booth"]
[ext_resource type="Shader" path="res://resources/shaders/camera_feed.gdshader" id="2_shader"]
[ext_resource type="Texture2D" path="res://ai_assets/textures/carnet/casco_overlay.png" id="3_helmet"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_feed"]
shader = ExtResource("2_shader")
shader_parameter/use_ycbcr = false
shader_parameter/mirror = true

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 24.0
content_margin_top = 20.0
content_margin_right = 24.0
content_margin_bottom = 20.0
bg_color = Color(0.05, 0.08, 0.15, 0.97)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.45, 0.72, 1, 0.75)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0.12, 0.2, 0.34, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.72, 1, 0.7)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_shoot"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0.85, 0.35, 0.12, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.8, 0.5, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frame"]
bg_color = Color(0.02, 0.03, 0.06, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.8, 0.65, 0.25, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="PhotoBooth" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_booth")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.72)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -290.0
offset_right = 420.0
offset_bottom = 290.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Row" type="HBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="PhotoFrame" type="PanelContainer" parent="Panel/Row"]
custom_minimum_size = Vector2(356, 408)
layout_mode = 2
size_flags_vertical = 4
theme_override_styles/panel = SubResource("StyleBoxFlat_frame")

[node name="Stack" type="Control" parent="Panel/Row/PhotoFrame"]
custom_minimum_size = Vector2(340, 392)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4

[node name="ViewportBox" type="SubViewportContainer" parent="Panel/Row/PhotoFrame/Stack"]
layout_mode = 0
offset_right = 340.0
offset_bottom = 392.0

[node name="CaptureViewport" type="SubViewport" parent="Panel/Row/PhotoFrame/Stack/ViewportBox"]
unique_name_in_owner = true
handle_input_locally = false
size = Vector2i(340, 392)
render_target_update_mode = 4

[node name="LiveBackground" type="ColorRect" parent="Panel/Row/PhotoFrame/Stack/ViewportBox/CaptureViewport"]
offset_right = 340.0
offset_bottom = 392.0
color = Color(0.08, 0.1, 0.16, 1)

[node name="LiveView" type="TextureRect" parent="Panel/Row/PhotoFrame/Stack/ViewportBox/CaptureViewport"]
unique_name_in_owner = true
material = SubResource("ShaderMaterial_feed")
offset_right = 340.0
offset_bottom = 392.0
expand_mode = 1
stretch_mode = 6

[node name="ResultView" type="TextureRect" parent="Panel/Row/PhotoFrame/Stack"]
unique_name_in_owner = true
visible = false
layout_mode = 0
offset_right = 340.0
offset_bottom = 392.0
expand_mode = 1
stretch_mode = 6

[node name="HelmetPreview" type="TextureRect" parent="Panel/Row/PhotoFrame/Stack"]
unique_name_in_owner = true
layout_mode = 0
offset_right = 340.0
offset_bottom = 392.0
mouse_filter = 2
texture = ExtResource("3_helmet")
expand_mode = 1
stretch_mode = 6

[node name="CountdownLabel" type="Label" parent="Panel/Row/PhotoFrame/Stack"]
unique_name_in_owner = true
layout_mode = 0
offset_right = 340.0
offset_bottom = 392.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 16
theme_override_font_sizes/font_size = 140
horizontal_alignment = 1
vertical_alignment = 1

[node name="Controls" type="VBoxContainer" parent="Panel/Row"]
custom_minimum_size = Vector2(390, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/Row/Controls"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 28
text = "CABINA DE FOTOS"

[node name="StatusLabel" type="Label" parent="Panel/Row/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.9, 1, 1)
theme_override_font_sizes/font_size = 17
text = "Buscando tu cámara..."
autowrap_mode = 3

[node name="HelmetToggle" type="CheckButton" parent="Panel/Row/Controls"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
button_pressed = true
text = "Ponerme el casco de astronauta"

[node name="ShootButton" type="Button" parent="Panel/Row/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("StyleBoxFlat_shoot")
theme_override_styles/hover = SubResource("StyleBoxFlat_shoot")
theme_override_styles/pressed = SubResource("StyleBoxFlat_shoot")
disabled = true
text = "TOMAR FOTO  (3, 2, 1...)"

[node name="UseButton" type="Button" parent="Panel/Row/Controls"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("StyleBoxFlat_shoot")
theme_override_styles/hover = SubResource("StyleBoxFlat_shoot")
theme_override_styles/pressed = SubResource("StyleBoxFlat_shoot")
text = "USAR ESTA FOTO"

[node name="RetryButton" type="Button" parent="Panel/Row/Controls"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button")
text = "REPETIR"

[node name="UploadButton" type="Button" parent="Panel/Row/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button")
text = "SUBIR UNA FOTO"

[node name="CancelButton" type="Button" parent="Panel/Row/Controls"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button")
text = "CANCELAR"

[node name="Privacy" type="Label" parent="Panel/Row/Controls"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.7, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "Tu foto se guarda solo en esta computadora. No se envía a internet. Puedes quitarla cuando quieras."
autowrap_mode = 3

[node name="FileDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Elige una foto tuya"
ok_button_text = "Abrir"
file_mode = 0
access = 2
use_native_dialog = true
filters = PackedStringArray("*.png, *.jpg, *.jpeg, *.webp ; Imágenes")

[connection signal="pressed" from="Panel/Row/Controls/ShootButton" to="." method="_on_shoot_pressed"]
[connection signal="pressed" from="Panel/Row/Controls/UseButton" to="." method="_on_use_pressed"]
[connection signal="pressed" from="Panel/Row/Controls/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Panel/Row/Controls/UploadButton" to="." method="_on_upload_pressed"]
[connection signal="pressed" from="Panel/Row/Controls/CancelButton" to="." method="_on_cancel_pressed"]
