corner_radius_bottom_left = 16

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_cancel"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.18, 0.2, 0.26, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6, 0.66, 0.78, 0.7)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[node name="DomeEnergyPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_panel")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.02, 0.05, 0.6)

[node name="Card" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -250.0
offset_right = 330.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Box" type="VBoxContainer" parent="Card"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Card/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.76, 0.55, 1, 1)
theme_override_font_sizes/font_size = 30
text = "DOMO: DESVIAR ENERGÍA AL ESCUDO"
horizontal_alignment = 1

[node name="InfoLabel" type="Label" parent="Card/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.9, 1, 1)
theme_override_font_sizes/font_size = 20
text = "Energía: 100%   ·   Escudo: 100%"
horizontal_alignment = 1

[node name="Question" type="Label" parent="Card/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
theme_override_font_sizes/font_size = 18
text = "¿Cuánta energía quieres mandar al escudo?"
horizontal_alignment = 1

[node name="Level1Button" type="Button" parent="Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 74)
layout_mode = 2
focus_mode = 0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_Level1Button")
theme_override_styles/hover = SubResource("StyleBoxFlat_Level1Button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_Level1Button_hover")
text = "NIVEL"

[node name="Level2Button" type="Button" parent="Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 74)
layout_mode = 2
focus_mode = 0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_Level2Button")
theme_override_styles/hover = SubResource("StyleBoxFlat_Level2Button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_Level2Button_hover")
text = "NIVEL"

[node name="Level3Button" type="Button" parent="Card/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 74)
layout_mode = 2
focus_mode = 0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 19
theme_override_styles/normal = SubResource("StyleBoxFlat_Level3Button")
theme_override_styles/hover = SubResource("StyleBoxFlat_Level3Button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_Level3Button_hover")
text = "NIVEL"

[node name="CancelButton" type="Button" parent="Card/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
theme_override_font_sizes/font_size = 17
theme_override_styles/normal = SubResource("StyleBoxFlat_cancel")
theme_override_styles/hover = SubResource("StyleBoxFlat_cancel")
theme_override_styles/pressed = SubResource("StyleBoxFlat_cancel")
text = "Cancelar  (Esc)"
